MONGO_URI=mongodb://CamusUnlockingStore:CamusUnlockingStore@ac-4uugunl-shard-00-00.axeqebx.mongodb.net:27017,ac-4uugunl-shard-00-01.axeqebx.mongodb.net:27017,ac-4uugunl-shard-00-02.axeqebx.mongodb.net:27017/CamusUnlockingStore?ssl=true&replicaSet=atlas-11zw5l-shard-0&authSource=admin&appName=Cluster0
