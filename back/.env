# Sécurit
JWT_SECRET=votre_super_cle_secrete_et_aleatoire_change_en_production
# URLs autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=https://mobile-unlock-store.vercel.app

# Fournisseurs API — chiffrement des clés + services automatiques
# ⚠️ À CHANGER avant la mise en production : exactement 32 caractères
ENCRYPTION_KEY=dev_placeholder_key_32_caracter1
SITE_BASE_URL=http://localhost:5000
POLLING_INTERVAL_MS=300000
RETRY_CHECK_INTERVAL_MS=60000

# Paiements automatiques — pages de retour côté frontend
PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel

